# Top-level constraints for the sky130 Core C physical integration.
#
# REF and TICK are independent input clocks.  DCO_OUT/MID_OUT/OUT_DIV are
# generated by the hardened counter macro and the digital divider.  The
# internal DSM_CK/CKR clocks are generated by pll_logic dividers from
# MID_OUT.  This is a real PnR/STA constraint set, not a timing signoff claim.

create_clock -name REF -period 375.000 [get_ports REF]
create_clock -name TICK -period 10.000 [get_ports TICK]

create_clock -name DCO_OUT -period 375.000 [get_pins dco/OUT]
# MID_OUT and INJ_EDGE are macro outputs with no exposed internal timing arc
# in the blackbox Liberty view.  Define independent clocks at the pins rather
# than generated clocks whose source path is invisible.
create_clock -name MID_OUT -period 375.000 [get_pins dco/MID_OUT]
create_generated_clock -name OUT_DIV -source [get_pins dco/MID_OUT] \
  -divide_by 2 [get_ports OUT_DIV]
create_clock -name INJ_EDGE -period 375.000 [get_pins dco/INJ_EDGE]

# pll_logic internal divided clocks.  The exact net aliases survive
# synthesis; the driver pin is selected from the net instead of relying on
# anonymous post-synthesis cell instance names.
set dsm_ck_pin [get_pins -of_objects \
  [get_nets -quiet {u_logic.dsm_impl.DSM_CK}] -filter {direction == output}]
if {[llength $dsm_ck_pin] != 1} {
  error "DSM_CK driver not found after synthesis"
}
create_generated_clock -name DSM_CK -source [get_pins dco/MID_OUT] \
  -divide_by 2 $dsm_ck_pin

set ckr_pin [get_pins -of_objects \
  [get_nets -quiet {u_logic.CKR}] -filter {direction == output}]
if {[llength $ckr_pin] != 1} {
  error "CKR driver not found after synthesis"
}
create_generated_clock -name CKR -source [get_pins dco/MID_OUT] \
  -divide_by 2 $ckr_pin

set_clock_uncertainty 0.050 [get_clocks REF]
set_clock_uncertainty 0.050 [get_clocks TICK]
set_clock_uncertainty 0.050 [get_clocks DCO_OUT]
set_clock_uncertainty 0.050 [get_clocks MID_OUT]
set_clock_uncertainty 0.050 [get_clocks OUT_DIV]
set_clock_uncertainty 0.050 [get_clocks INJ_EDGE]
set_clock_uncertainty 0.050 [get_clocks DSM_CK]
set_clock_uncertainty 0.050 [get_clocks CKR]

# Static configuration and reset/control inputs are referenced to REF.  The
# TICK and DCO domains are intentionally not merged into a broad false-path
# group: the Gray-bus max-delay below must remain active.
set_input_delay 0.500 -clock REF \
  [get_ports {RST_N INJ_EN KP[*] KI[*] FCW[*] DSM_EN_DT DSM_EN_SHDT DSM_ORDER[*] SET_DIV[*] LOAD_DIV}]
set_output_delay 0.500 -clock REF [get_ports {LOCKED ERR}]

# Gray-bus source/destination relationship.  The RTL names are preserved as
# net aliases after flattening, but the flop instances are anonymous, so the
# pins are resolved from the exact net aliases.
set gray_nets {}
for {set i 0} {$i < 16} {incr i} {
  set n [get_nets -quiet "u_logic.flock.cnt_gray\[$i\]"]
  if {[llength $n]} {
    lappend gray_nets $n
  }
}
if {[llength $gray_nets] != 16} {
  error "expected 16 Gray source nets, found [llength $gray_nets]"
}
set gray_src [get_pins -of_objects $gray_nets -filter {direction == output}]
set gray_dst [get_pins -of_objects $gray_nets -filter {direction == input}]
if {[llength $gray_src] == 0 || [llength $gray_dst] == 0} {
  error "Gray source/destination pins not found"
}
set_max_delay 0.500 -from $gray_src -to $gray_dst
