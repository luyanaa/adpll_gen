current_design PLL_ANALOG_MACRO
###############################################################################
# Timing Constraints
###############################################################################
create_clock -name REF -period 20.0000 [get_ports {REF}]
set_clock_uncertainty -setup 0.2500 REF
set_clock_uncertainty -hold 0.0500 REF
set_propagated_clock [get_clocks {REF}]
create_clock -name OUT -period 2.5000 [get_ports {OUT}]
set_clock_uncertainty -setup 0.2500 OUT
set_clock_uncertainty -hold 0.0500 OUT
set_propagated_clock [get_clocks {OUT}]
create_clock -name MID_OUT -period 2.5000 [get_ports {MID_OUT}]
set_clock_uncertainty -setup 0.2500 MID_OUT
set_clock_uncertainty -hold 0.0500 MID_OUT
set_propagated_clock [get_clocks {MID_OUT}]
create_clock -name INJ_EDGE -period 20.0000 [get_ports {INJ_EDGE}]
set_clock_uncertainty -setup 0.2500 INJ_EDGE
set_clock_uncertainty -hold 0.0500 INJ_EDGE
set_propagated_clock [get_clocks {INJ_EDGE}]
set_clock_groups -name group1 -asynchronous \
 -group [get_clocks {INJ_EDGE}]\
 -group [get_clocks {MID_OUT}]\
 -group [get_clocks {OUT}]\
 -group [get_clocks {REF}]
set_input_delay 1.0000 -clock [get_clocks {REF}] -min -add_delay [get_ports {COARSE_MUX[0]}]
