      LAYER Metal1 ;
        RECT 0.900 0.400 1.060 0.500 ;
        RECT 0.830 0.100 1.130 0.400 ;
        RECT 0.900 0.000 1.060 0.100 ;
      LAYER Via1 ;
        RECT 0.880 0.150 1.080 0.350 ;
      LAYER Metal2 ;
