VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO sg13g2_lv_nmos
  CLASS BLOCK ;
  FOREIGN sg13g2_lv_nmos ;
  ORIGIN 1.130 1.310 ;
  SIZE 3.390 BY 3.120 ;
  PIN S
    ANTENNADIFFAREA 0.132500 ;
    PORT
      LAYER Metal1 ;
        RECT 0.070 0.400 0.230 0.500 ;
        RECT 0.000 0.100 0.300 0.400 ;
        RECT 0.070 0.000 0.230 0.100 ;
      LAYER Via1 ;
        RECT 0.050 0.150 0.250 0.350 ;
      LAYER Metal2 ;
        RECT 0.000 0.100 0.300 0.400 ;
